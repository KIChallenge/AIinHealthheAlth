# Copy to .env (ignored by git) and fill in. Real environment variables win over .env,
# and .env wins over config/simulator.json.

# --- Neo4j (healthdb reads NEO4J_USER, healthsim accepts NEO4J_USERNAME or NEO4J_USER) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_DATABASE=neo4j
NEO4J_USERNAME=neo4j
NEO4J_USER=neo4j
NEO4J_PASSWORD=<choose-a-password-min-8-chars>

# Optional overrides for the importer
# HEALTHDB_DATA_DIR=./data
# HEALTHDB_ACTORS_FILE=./config/actors.json

# Integration tests (throwaway container from `docker compose --profile test up -d`)
NEO4J_TEST_URI=bolt://localhost:7688
NEO4J_TEST_USER=neo4j
NEO4J_TEST_PASSWORD=<test-password-min-8-chars>
NEO4J_TEST_DATABASE=neo4j

# --- Azure OpenAI ---
# Resource name (not a personal login). Used only if AZURE_OPENAI_ENDPOINT is empty.
AZURE_OPENAI_ACCOUNT_NAME=
# Origin or base URL; /openai/v1/ is added exactly once.
AZURE_OPENAI_ENDPOINT=
# The name in the Deployments list of the Azure portal. It is not the model family.
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_KEY=

# --- Model settings ---
LLM_PROVIDER=azure_openai
LLM_MODEL=gpt-5.4-mini
# Only responses_v1 is implemented; anything else stops with an error.
LLM_API_MODE=responses_v1
# none, low, medium, high or xhigh
LLM_REASONING_EFFORT=medium
LLM_MAX_CONCURRENCY=9
LLM_RATE_LIMIT_TPS=200000
# Empty means unknown, not unlimited.
LLM_RATE_LIMIT_RPM=
LLM_RATE_LIMIT_TPM=
LLM_REQUEST_TIMEOUT_SECONDS=1800
LLM_FINAL_REPORT_TIMEOUT_SECONDS=1800
LLM_MAX_RETRIES=1
LLM_INPUT_BUDGET_TOKENS=272000
LLM_MAX_OUTPUT_TOKENS=128000
LLM_INITIAL_MAX_OUTPUT_TOKENS=128000
LLM_FINAL_MAX_OUTPUT_TOKENS=128000

DELIBERATION_TIMEOUT_SECONDS=1620
FINALIZATION_TIMEOUT_SECONDS=180
STATE_DIR=./state
